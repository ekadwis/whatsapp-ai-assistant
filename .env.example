# =========================
# WhatsApp AI Assistant
# Environment Template
# =========================

# --- LLM (OpenAI-compatible) ---
LLM_API_KEY=sk-your_api_key_here
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_MODEL=gpt-5.4

# --- Google Sheets ---
# Path to your downloaded Google service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./data/google/service-account.json

# Spreadsheet ID from:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# --- WhatsApp Session Store (SQLite) ---
WHATSAPP_SESSION_DB_PATH=./data/whatsapp/session.db

# --- Owner Whitelist ---
# Digits only, no "+" prefix. Example: 6281234567890
OWNER_PHONE_NUMBER=6281234567890
